# ========================================================
# LONGTECH - CẤU HÌNH APACHE CHO CLOUD RENDER
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bỏ qua favicon.ico và robots.txt nếu không có
    RewriteRule ^(favicon\.ico|robots\.txt)$ - [L]

    # 1. Chặn file nhạy cảm
    <FilesMatch "(^\.env|\.sql|\.log|\.git|config\.php)$">
        Require all denied
    </FilesMatch>

    # 2. Chặn duyệt thư mục code
    RewriteRule ^(includes|models|controllers)/ - [F,L,NC]

    # 3. Chặn chạy php trong uploads
    RewriteRule ^assets/uploads/.*\.php$ - [F,L,NC]

    # 4. Nếu là file hoặc thư mục thật thì mở trực tiếp
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Định tuyến vào index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8
